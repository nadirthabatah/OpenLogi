# OpenRoadie udev rules
#
# Grants the active-seat user read/write access to the HID devices this program
# drives, the input event nodes it reads, and the uinput kernel module — no
# group membership required on systems running systemd-logind (uaccess tag).
#
# Device families are listed by vendor rather than caught by a wildcard. A rule
# matching every hidraw node would hand the logged-in user every HID device on
# the system, including ones nothing here has any business touching, and that
# is a much worse trade than naming the vendors we actually drive.
#
# Install:
#   sudo cp 70-roadie.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Non-systemd fallback (SysV init, OpenRC, etc.):
#   Replace TAG+="uaccess" with MODE="0660", GROUP="input" and add your user to
#   the 'input' group: sudo usermod -aG input $USER  (re-login required).

# Logitech HID++ receivers and directly-connected devices (hidraw interface).
# Two rules are needed to cover both transports:
#   - USB / Unifying / Bolt receivers: ATTRS{idVendor} walks the USB sysfs chain.
#   - Bluetooth (uhid virtual bus): ATTRS{idVendor} is absent; match on the HID
#     kernel name format "bus:VID:PID.iface" whose VID field is always uppercase.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="*:046D:*", TAG+="uaccess"

# Elgato Stream Decks and the Stream Deck Pedal (hidraw interface).
#
# Separate from the Logitech block above because this program is no longer a
# Logitech utility: it configures a Stream Deck through the same raw HID path,
# and rules that covered only one vendor left someone whose only device is a
# deck with a hub that could see nothing and no way to tell why.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0fd9", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="*:0FD9:*", TAG+="uaccess"

# QMK keyboards and macro pads with VIA enabled are deliberately NOT covered
# here, and cannot be: VIA is identified by a HID usage page, which udev has no
# way to match, and the boards that run it come from hundreds of vendors under
# their own ids. Adding a wildcard rule to catch them would hand every HID
# device on the system to the logged-in user, which is a far worse trade than
# one extra line of setup.
#
# `roadie doctor` closes that gap the honest way: it finds the devices this
# program cannot open, reads their vendor ids, and prints the exact rule line
# to add for them. Put those in a file of your own, e.g.
# /etc/udev/rules.d/71-roadie-local.rules, so an upgrade to this file does
# not overwrite them.

# uinput virtual device node — needed for the evdev/uinput input hook.
# OPTIONS+="static_node=uinput" creates the node at boot even before any device
# is plugged in, so the agent can open it without a trigger.
KERNEL=="uinput", TAG+="uaccess", OPTIONS+="static_node=uinput"

# Logitech pointer event nodes (evdev interface) — the read side of the hook.
# hidraw alone is not enough: the hook enumerates /dev/input/event* to grab the
# pointer. USB devices already get uaccess from logind's seat rules, but a
# Bluetooth mouse hangs off /devices/virtual/misc/uhid, which belongs to no
# seat, so those rules never tag it and its event node stays root:input 0660.
#
# Scoped to event nodes the kernel classifies as a mouse (ID_INPUT_MOUSE, set by
# the input_id builtin in 60-input-id.rules, which runs before this file): a
# Logitech keyboard's keystrokes must never become readable session-wide. The
# two matchers cover the same two transports as the hidraw block above.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", ATTRS{idVendor}=="046d", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", KERNELS=="*:046D:*", TAG+="uaccess"
